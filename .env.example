# Copia questo file in .env.local e compila i valori.

# --- Sanity (obbligatori) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con permesso "Editor": salva le prenotazioni e legge le bozze in anteprima.
# Resta solo sul server. Non va mai messo in una variabile NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=

# --- Sito ---
# Indirizzo pubblico, senza barra finale. Serve per sitemap e anteprime social.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email delle prenotazioni (facoltative) ---
# Stessi nomi usati negli altri siti. Senza questi valori le email non partono,
# ma le prenotazioni vengono comunque salvate e si vedono nello Studio.
SMTP_SERVER_HOST=
SMTP_SERVER_PORT=465
SMTP_SERVER_USERNAME=
SMTP_SERVER_PASSWORD=
# Mittente, se diverso dall'utente SMTP.
SMTP_FROM=
# Dove arrivano gli avvisi di nuova prenotazione. Se vuoto si usa l'email
# impostata nello Studio.
SITE_MAIL_RECIEVER=

# --- Pulizia automatica delle prenotazioni vecchie ---
# Una stringa casuale lunga. Su Vercel basta impostarla: il cron la invia da solo.
CRON_SECRET=
